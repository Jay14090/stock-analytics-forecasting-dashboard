# Copy to .env.local to override. Both are optional in development.

# Where the Vite dev server proxies /api requests.
VITE_API_TARGET=http://127.0.0.1:5000

# Absolute API base, used when the frontend is served separately from the API
# (a static build on a CDN, for example). Leave unset to use the /api proxy.
# VITE_API_URL=https://api.example.com/api
