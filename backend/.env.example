# Copy to .env and adjust. Every value below is optional; the defaults shown
# are what the application uses when the variable is absent.

# development | testing | production
APP_ENV=development

# Required in production — startup fails if this is left at the default.
SECRET_KEY=dev-secret-change-me

# Any SQLAlchemy URL. Defaults to SQLite under backend/instance/.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/stockdash

# Comma-separated origins allowed to call /api/*
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Market data caching (seconds) ---
QUOTE_CACHE_TTL=60
HISTORY_CACHE_TTL=900
NEWS_CACHE_TTL=1800
CACHE_MAX_ENTRIES=512
MARKET_DATA_TIMEOUT=20

# --- Forecasting ---
SEQUENCE_LENGTH=60
FORECAST_HORIZON=5
TRAIN_EPOCHS=40
TRAIN_BATCH_SIZE=32
VALIDATION_SPLIT=0.15
MIN_TRAINING_ROWS=250
MODEL_MAX_AGE_HOURS=24
# MODEL_DIR=/var/lib/stockdash/models

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false
